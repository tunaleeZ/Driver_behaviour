# Dataset .gitignore — generated by init_dataset.py
# Heavy data directories (not tracked by git)
raw/
segments/*/*
processed/
features/

# Media and array files
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.npz
*.npy
*.pt
*.pth

# Keep lightweight files
!annotations/
!scripts/
!**/.gitkeep
!README_Driver_Behavior_Dataset.md
